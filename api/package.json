    "@fastify/sensible": "^5.6.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "fastify": "^4.28.0",
    "fastify-plugin": "^4.0.0"
  },
  "devDependencies": {
    "c8": "^10.1.2",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.1.0",
