{
  "name": "@aztec-fpc/attestation-lib",
  "version": "0.1.0",
  "description": "Minimal Schnorr attestation library for Aztec",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-specifier-resolution=node --loader ts-node/esm test-attestor.ts",
    "deploy-example": "bun run src/deploy-example.ts",
    "deploy-migration": "bun run src/deploy-migration.ts",
    "claim-migration": "bun run src/claim-migration.ts",
    "migrate-nft": "bun run src/migrate-nft-public.ts"
  },
  "dependencies": {
    "@aztec/accounts": "5.0.0-rc.1",
    "@aztec/aztec.js": "5.0.0-rc.1",
    "@aztec/ethereum": "5.0.0-rc.1",
    "@aztec/foundation": "5.0.0-rc.1",
    "@aztec/l1-artifacts": "5.0.0-rc.1",
    "@aztec/stdlib": "5.0.0-rc.1",
    "@aztec/wallets": "5.0.0-rc.1",
    "viem": "npm:@aztec/viem@2.38.2"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "Apache-2.0"
}
